{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Device Tool: Build",
      "type": "shell",
      "command": "python3",
      "windows": {
        "command": "py",
        "args": [
          "-3",
          "${workspaceFolder}/user/develop/quick_deploy.py",
          "build"
        ]
      },
      "osx": {
        "command": "python3"
      },
      "linux": {
        "command": "python3"
      },
      "args": [
        "${workspaceFolder}/user/develop/quick_deploy.py",
        "build"
      ],
      "problemMatcher": [
        "$gcc"
      ],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "clear": true,
        "showReuseMessage": false
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
